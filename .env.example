# Created by Yanjunhui
# Optional host paths shared by initialization and runtime Compose.
# Tunnel ID and credentials are configured by init, not in this file.
# 初始化与运行 Compose 使用的可选宿主机目录。
# 隧道 ID 和凭据通过 init 配置，不写入此文件。
TUNNEL_SSH_CONFIG_DIR=./data
TUNNEL_SSH_INIT_INPUT_DIR=./init-input
TUNNEL_SSH_WORKSPACE_DIR=./workspace
# Optional image tags let acceptance builds stay separate from a live deployment.
# 可选镜像标签使验收构建与正在运行的部署分别管理。
TUNNEL_SSH_MCP_IMAGE=go-tunnel-ssh-mcp:latest
TUNNEL_SSH_DEV_IMAGE=go-tunnel-ssh-dev:latest
# Optional desktop overlay image; SSH-only builds do not install a GUI.
# 可选桌面叠加镜像；仅 SSH 构建不安装图形环境。
TUNNEL_CONSOLE_DESKTOP_IMAGE=go-tunnel-console-desktop:latest
